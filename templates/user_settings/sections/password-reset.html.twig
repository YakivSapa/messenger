{% block password_reset %}
        <h3>Password Reset</h3>
        <hr>
        <p>To reset your password, please click the button below. You will receive an email with instructions on how to reset your password.</p>
        <form class="password-reset-form" method="post">
                <button type="submit" class="btn btn-primary">Reset Password</button>
        </form>
{% endblock %}