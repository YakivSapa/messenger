{% extends 'base.html.twig' %}

{% block title %}Search People{% endblock %}

{% block body %}
    <h3 id="page-title">Search new contacts<h3>
    <div id="community_search_field">
        <form method="get" action="{{ path('app_community_search_user')}}">
            <input type="text" name="q" value="{{ searchQuery }}" placeholder="Search users..." minlength="2">
            <button type="submit">Search</button>
        </form>
    </div>
    <div id="community_search_results">
        {% if searchQuery %}
            {% if users|length > 0 %}
                <ul>
                    {% for user in users %}
                        {{ include('community_search_user/card.html.twig', { user: user }) }}
                    {% endfor %}
                </ul>
            {% else %}
                <p>No users found for "{{ searchQuery }}"</p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
