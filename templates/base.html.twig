<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.simplecss.org/simple.css">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
    {% set current_route = app.request.attributes.get('_route') %}
    <header>
    <ul class="navbar">
        <li><a href="{{ path('app_home') }}" class="{{ current_route == 'app_home' ? 'active' : '' }}">
            Home
        </a></li>
        {% if app.user %}
        {# TODO #}
        {# <li>
            <a href="{{ path('app_social') }}" class="{{ current_route == 'app_social' ? 'active' : '' }}">
            Friends&Chat
            </a>
        </li> #}
        <li>
            <a href="{{ path('app_community') }}" class="{{  current_route == 'app_community' ? 'active' : ''  }}">
            Community
            </a>
        </li>
        <li class="dropdown">
            <a href="#" class="dropdown-toggle">My Profile ▾</a>
            <ul class="dropdown-menu">
                <li><a href="{{ path('app_profile', {'uuid': app.user.uuid}) }}" class="{{ current_route == 'app_profile' ? 'active' : '' }}">
                    View Profile
                </a></li>
                <li><a href="{{ path('app_user_settings') }}" class="{{ current_route == 'app_user_settings' ? 'active' : '' }}">
                    Settings
                </a></li>
                <li><a href="{{ path('app_logout') }}">
                    Log out
                </a></li>
            </ul>
        </li>
        {% else %}
        <li>
            <a href="{{ path('app_login') }}">Login</a>
            <span>/</span>
            <a href="{{ path('app_register') }}">Registration</a>
        </li>
        {% endif %}
    </ul>
    </header>
        {% block error %}{% endblock %}
        {% block body %}
        {% for flash in app.flashes('verify_email_success') %}
            <div class="alert alert-success">{{ flash }}</div>
        {% endfor %}
        {% for flash in app.flashes('verify_email_error') %}
            <div class="alert alert-danger">{{ flash }}</div>
        {% endfor %}
        {% endblock %}
    </body>
</html>